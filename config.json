{
    "$schema": "../../schema/jinks.json",
    "type": "feature",
    "id": "https://e-editiones.org/app/tei-publisher/dts-mod",
    "label": "dts-mod",
    "description": "Add necessary components to retrieve data from a DTS api external endpoint, explore textual content trough a dts /navigation endpoint and more",
    "version": "1.0.0",
    "dts-mod": {
        "dts-endpoint": "http://host.docker.internal:8000/api/dts/v1/"
    },
    "api": [
        {
            "spec": "dts-api.json",
            "prefix": "dmod-vapi",
            "path": "dmod-view.xql",
            "id": "http://teipublisher.com/api/dmod-vapi"
        },
        {
            "spec": "dts-api.json",
            "prefix": "dmod-capi",
            "path": "dmod-collection.xql",
            "id": "http://teipublisher.com/api/dmod-capi"
        }
    ]
}
