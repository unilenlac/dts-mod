{
    "$schema": "../../schema/jinks.json",
    "type": "feature",
    "id": "https://e-editiones.org/app/tei-publisher/dts-mod",
    "label": "dts-mod",
    "description": "Add necessary components to retrieve data from a DTS api external endpoint, explore textual content trough a dts /navigation endpoint and more",
    "version": "1.0.0",
    "dts-mod": {
        "dts-endpoint": "http://host.docker.internal:8000/api/dts/v1/",
        "public-dts-endpoint": "http://localhost:8000/api/dts/v1/",
        "resource-identifier": {
            "element": {
                "namespace": "http://www.tei-c.org/ns/1.0",
                "name": "TEI"
            },
            "source": "document-name"
        }
    },
    "script": {
        "custom": [
            "resources/scripts/metadata-panel.js",
            "resources/scripts/dmod-toggle.js",
            "resources/scripts/dmod-endpoint-infos.js"
        ]
    },
    "styles": [
        "resources/css/dts-elements.css"
    ],
    "templating": {
        "use": [
            "templates/metadata-panel.html"
        ]
    },
    "api": [
        {
            "spec": "dts-api.json",
            "prefix": "dmod",
            "path": "dmod-routes.xql",
            "id": "http://teipublisher.com/api/dmod"
        }
    ],
    "depends": [
        "base10",
        "metadata-panel"
    ],
    "features": {
        "dts-mod": {
            "metadata-panel": {
                "enabled": true
            }
        }
    },
    "menu": {
        "search": false,
        "items": [{
            "url": "search.html",
            "id": "Search"
        }]
    },
    "theme": {
        "layout": {
        "before": {
            "hidden": true
            }
        }
    }
}
