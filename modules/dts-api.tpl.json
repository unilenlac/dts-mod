{
    "openapi": "3.0.3",
    "info": {
        "version": "1.0.0",
        "title": "dts-mod – Custom API",
        "description": "TEIpublisher dts-mod features endpoints"
    },
    "servers": [
        {
            "description": "Endpoint for testing on localhost",
            "url": "/exist/apps/[[$pkg?abbrev]]"
        }
    ],
    "components": {
        "securitySchemes": {
            "basicAuth": {
                "type": "http",
                "scheme": "basic"
            },
            "cookieAuth": {
                "type": "apiKey",
                "name": "teipublisher.com.login",
                "in": "cookie"
            }
        }
    },
    "tags": [
		{
    		"name": "dmod",
    		"description": "dts-mod view routes"
    	}
    ],
    "paths": {
		"/endpoint-infos": {
			"get": {
				"summary": "Retrieve endpoint information",
				"description": "Get information about the available endpoints in the dts-mod module.",
				"tags": ["dmod"],
				"operationId": "dmod:endpoint-infos",
				"parameters": [
					{
						"name": "resource",
						"in": "query",
						"description": "DTS resource identifier",
						"required": false,
						"schema": {
							"type": "string",
							"example": "bonnet-er"
						}
					},
					{
						"name": "ref",
						"in": "query",
						"description": "Passage reference used to build the excerpt link",
						"required": false,
						"schema": {
							"type": "string",
							"example": "bonnet-er"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Endpoint information",
						"content": {
							"text/html": {
								"schema": {
									"type": "string"
								}
							}
						}
					}
				}
			}
		}
	},
    "security": [
        {
            "cookieAuth": []
        },
        {
            "basicAuth": []
        }
    ]
}